# Generate environment

```bash
mamba env create -f ../environment_benchmarking.yml
```

# Benchmarking execution

```bash
# inside benchmarking

hic_path=$(realpath "../test_data/GM12878-HRC.hic")

# Submits one job per (chromosome x resolution x pval) combination.
# Any extra flags (e.g. -d 0.5 -k 3) are forwarded to the script.
# Usage: submit_jobs <script> <job_prefix> [extra flags...]
submit_jobs() {
    local script=$1 prefix=$2; shift 2
    for r in "${resolutions[@]}"; do
        for c in "${chromosomes[@]}"; do
            for p in "${pval[@]}"; do
                sbatch --job-name="${prefix}_chr${c}_res${r}" \
                    "$script" -f "$hic_path" -c "$c" -r "$r" -p "$p" "$@"
            done
        done
    done
}
```

## Spikes
```bash
chromosomes=($(seq 1 22)); resolutions=(50000 100000 250000); pval=(0.01)
k_spikes=(2 3 4)

for k in "${k_spikes[@]}"; do
    submit_jobs run_benchmarking_spikes.sh "Benchmarking_DifFraction_spikes" -k "$k"
done
```

## Downsample
```bash
chromosomes=($(seq 1 23)); resolutions=(50000 100000 250000); pval=(0.01)
ds=(0.1 0.25 0.75 1.0)

# Run all tools (default)
for d in "${ds[@]}"; do
    submit_jobs run_benchmarking_downsample.sh "ds_Benchmarking_ds${d}" -d "$d"
done

# Run a specific tool only: -s diffraction | diffHic | HiCcompare | HiCDCPlus | multiHiCcompare
# Add -t alpha|iterative|both when using -s diffraction
for d in "${ds[@]}"; do
    submit_jobs run_benchmarking_downsample.sh "ds_Benchmarking_diffraction_ds${d}" -d "$d" -s diffraction -t both
done

for d in "${ds[@]}"; do
    submit_jobs run_benchmarking_downsample.sh "ds_Benchmarking_diffraction_ds${d}" -d "$d" -s diffHic 
done
```

## Downsample and spikes
```bash
chromosomes=($(seq 1 22)); resolutions=(50000 100000 250000); pval=(0.01)
ds=(0.1 0.25 0.5 0.75 1.0); k_spikes=(2 3 4)

for d in "${ds[@]}"; do
    for k in "${k_spikes[@]}"; do
        submit_jobs run_benchmarking_downsample_n_spikes.sh "ds_Benchmarking_DifFracTion_ds${d}_k${k}" -d "$d" -k "$k"
    done
done
```